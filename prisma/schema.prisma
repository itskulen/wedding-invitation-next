// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Guest RSVP attendance (stored in MySQL when DATABASE_URL is set).
model Attendance {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(191)
  address    String   @db.VarChar(500)
  status     String   @db.VarChar(20) // "attend" | "not_attend"
  inviteTag  String?  @db.VarChar(191) // optional ?guest= from invitation link
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("attendances")
}
/// Guest wishes/messages (stored in MySQL when DATABASE_URL is set).
model Wish {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(191)
  message   String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("wishes")
}